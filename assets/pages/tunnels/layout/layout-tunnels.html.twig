{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{#- Every page of the Tunnels section: its title in a toolbar, a lead, then the
    page. A page setting `tunnel_name` is the page of a tunnel: the toolbar
    opens that tunnel in a modal or a panel, and the page starts with the card
    walking it and its roads, one timeline each, every step saying what it
    shows — texts under `steps.<step name>` of the page, roads computed by the
    controller as `paths`. -#}
{%- set page_show_title = true -%}
{%- set layout_domain = 'WexampleSymfonyTunnelsDemoBundle.pages.tunnels.layout.layout-tunnels::' -%}
{%- set overlay_options = { closeOnEscape: true, closeOnOverlayClick: true } -%}
{%- set tunnel_url = tunnel_name is defined ? tunnel_entrypoint_url(tunnel_name) : null -%}

{%- block page_title_actions -%}
    {%- if tunnel_url -%}
        {{ button_target('ph:bold/app-window', layout_domain ~ 'open.modal', tunnel_url, 'modal', { class: 'button', target_options: overlay_options }) }}
        {{ button_target('ph:bold/sidebar-simple-duotone', layout_domain ~ 'open.panel', tunnel_url, 'panel', { class: 'button', target_options: overlay_options }) }}
    {%- endif -%}
{%- endblock -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro'|trans }}</p>

    {%- if tunnel_url -%}
        <a class="block block--padded block--link" href="{{ tunnel_url }}">
            <span class="block--link-icon">{{ icon(tunnel_icon) }}</span>
            <span class="block--link-title">{{ (layout_domain ~ 'start.title')|trans }}</span>
            <span class="block--link-description">{{ '@page::start'|trans }}</span>
        </a>

        <h2>{{ (layout_domain ~ 'roads.title')|trans }}</h2>
        <p>{{ '@page::roads.description'|trans }}</p>
        <div class="stack--vertical">
            {%- for road in paths -%}
                {%- set items = [] -%}
                {%- for item in road.timeline.items -%}
                    {%- set items = items|merge([item|merge({ text: ('@page::steps.' ~ item.step)|trans })]) -%}
                {%- endfor -%}

                <div class="block block--padded stack--vertical">
                    <strong>{{ ('@page::roads.' ~ road.options|first)|trans }}</strong>
                    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/timeline', {}, road.timeline|merge({ items: items })) }}
                </div>
            {%- endfor -%}
        </div>
    {%- endif -%}

    {%- block tunnels_page_body -%}{%- endblock -%}
{%- endblock -%}
