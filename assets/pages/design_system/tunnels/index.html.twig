{%- extends '@WexampleSymfonyDesignSystemDemoBundle/layouts/design_system/layout.html.twig' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro'|trans }}</p>

    <h2>{{ '@page::demo.title'|trans }}</h2>
    <p>{{ '@page::demo.body'|trans }}</p>
    <p>{{ button_link('ph:bold/play', '@page::demo.walk'|trans, path('tunnel_demo_index')) }}</p>

    <h2>{{ '@page::tree.title'|trans }}</h2>
    <p>{{ '@page::tree.body'|trans }}</p>
    <div class="block block--padded">
        <ul>
            {%- for line in tunnelTree -%}
                <li style="margin-left: {{ line.depth * 1.5 }}rem">
                    <code>{{ line.name }}</code>
                    {%- if line.options %} <small>{{ line.options }}</small>{% endif -%}
                </li>
            {%- endfor -%}
        </ul>
    </div>

    <h2>{{ '@page::watch.title'|trans }}</h2>
    <p>{{ '@page::watch.body'|trans({ '%tunnel%': tunnelName }) }}</p>
{%- endblock -%}
