{%- extends '@WexampleSymfonyTunnelsDemoBundle/tunnels/demo/layout.html.twig' -%}

{%- block tunnel_step_body -%}
    <p>{{ '@page::body'|trans }}</p>

    {#- The same step twice, one cursor per plan: picking a link picks a branch. -#}
    <p>
        {%- for next in tunnelCursor.next -%}
            {{ button_link('ph:bold/path', next.options.plan|capitalize, tunnel_cursor_url(next)) }}
        {%- endfor -%}
    </p>
{%- endblock -%}
