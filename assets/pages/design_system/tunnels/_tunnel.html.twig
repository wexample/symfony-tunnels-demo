{#- What the two tunnel pages share: the card starting the tunnel, then its
    roads drawn one timeline each, every step saying what it shows. Expects
    `tunnelRoute`, `tunnelIcon` and `paths`; texts come from the including
    page, under `steps.<step name>`. -#}
<a class="block block--padded block--link" href="{{ path(tunnelRoute) }}">
    <span class="block--link-icon">{{ icon(tunnelIcon) }}</span>
    <span class="block--link-title">{{ '@page::start.title'|trans }}</span>
    <span class="block--link-description">{{ '@page::start.description'|trans }}</span>
</a>

<h2>{{ '@page::roads.title'|trans }}</h2>
<p>{{ '@page::roads.description'|trans }}</p>
<div class="stack--vertical">
    {%- for road in paths -%}
        {%- set items = [] -%}
        {%- for item in road.timeline.items -%}
            {%- set items = items|merge([item|merge({ text: ('@page::steps.' ~ item.step)|trans })]) -%}
        {%- endfor -%}

        <div class="block block--padded stack--vertical">
            <strong>{{ ('@page::roads.' ~ road.options|first)|trans }}</strong>
            {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/timeline', {}, road.timeline|merge({ items: items })) }}
        </div>
    {%- endfor -%}
</div>
